# helpcore — example configuration
# Copy to config.toml and edit before starting the server.
# Quick start: cp config.toml.example config.toml  (or: make config)

[server]
# Human-readable name shown in the setup wizard.
name = "My helpcore"

# Public base URL of this server (used in the first-run setup URL).
url  = "http://localhost:3000"

# Port to listen on. Must match the EXPOSE / ports mapping in docker-compose.
port = 3000

[data]
# Where helpcore stores its database and user data.
#
# Docker:  leave this commented out — HELPCORE_DATA=/data is set by
#          docker-compose and takes precedence.
#
# Native:  uncomment and set an absolute path, or leave commented out to use
#          the default (~/.helpcore/data on macOS/Linux).
#
# dir = "/data"

[logging]
# Log level: trace | debug | info | warn | error
level = "info"

[plugins]
# Plugin IDs that can never be installed on this server, regardless of who asks.
blacklist = []

[registry]
# Direct URL to a plugin registry JSON file. This can be self-hosted.
url = "https://github.com/doomedramen/helpcore-plugins/releases/download/plugins-latest/plugins.json"

[sandbox]
# Docker sandbox for the assistant's workspace tools (sandbox_exec & friends).
# Commands run in a long-lived session container with a persistent volume
# mounted at /workspace; the container is recreated when settings change and
# removed after 30 minutes idle.
enabled = false

# Image for the session container. Build the bundled image with:
#   make sandbox-image
# Any image with /bin/sh and coreutils (timeout) works.
image = "helpcore-sandbox:latest"

# Default per-command timeout in seconds (commands may request up to 600).
timeout = 120

# Resource limits for the session container. Compilers and test suites need
# real headroom — raise these if builds are slow or get OOM-killed.
memory_mb = 4096
cpus = 2.0

# Docker host. Leave unset for the local daemon (respects DOCKER_HOST), or
# point at a remote daemon, e.g. "tcp://192.168.1.10:2375".
# host = "unix:///var/run/docker.sock"

# Repositories cloned into /workspace when the session container starts
# (skipped if the directory already exists).
# repos = ["https://github.com/you/your-project.git"]

# [sandbox.git]
# Git identity used for commits made inside the sandbox.
# user_name  = "My Assistant"
# user_email = "assistant@example.com"
#
# Access token for HTTPS git remotes (cloning private repos, pushing).
# The token is injected into the container environment and used via a git
# credential helper; it is never written to disk inside the container.
# For GitHub, a fine-grained PAT with contents read/write works; token_user
# can usually stay at its default ("x-access-token").
# token      = "github_pat_..."
# token_user = "x-access-token"

# ── Providers ──────────────────────────────────────────────────────────────────
# At least one provider with role "chat" is required for /chat to work.
# Multiple providers can be listed; the first matching role is used unless
# the client specifies a provider_id.

# ── Recommended for low-RAM home servers (4 GB free) ─────────────────────────
# qwen2.5:3b  — ~2 GB RAM, excellent instruction following for size
# phi3.5:mini — ~2.2 GB RAM, strong reasoning
# gemma2:2b   — ~1.6 GB RAM, fits in very tight setups
#
# Pull with:  ollama pull qwen2.5:3b
#             (or: docker compose exec ollama ollama pull qwen2.5:3b)

[[providers]]
id            = "ollama"
name          = "Ollama"
type          = "ollama"
default_model = "qwen2.5:3b"
roles         = ["chat"]

# Context window — set to match your model's actual window.
# qwen2.5:3b and most 3B models: 4096 (some support up to 8192)
# phi3.5:mini: 4096
# llama3.2:3b: 4096
# Leave unset to use the server default of 8192.
num_ctx = 4096

# Max tokens to generate per response. Unset = 2048 (server default).
# num_predict = 2048

# ── Ollama URL variants ────────────────────────────────────────────────────────
# Running Ollama directly on the host (native or Docker host network):
url = "http://localhost:11434"

# Running helpcore AND Ollama via docker-compose --profile with-ollama:
# url = "http://ollama:11434"

# helpcore in Docker, Ollama on the host (Docker Desktop):
# url = "http://host.docker.internal:11434"


# ── Larger models (if you have the RAM) ───────────────────────────────────────
# [[providers]]
# id            = "ollama-big"
# name          = "Ollama (large)"
# type          = "ollama"
# default_model = "llama3.1:8b"   # ~6 GB RAM
# roles         = ["chat", "code"]
# url           = "http://localhost:11434"
# num_ctx       = 8192


# ── Anthropic ─────────────────────────────────────────────────────────────────
# [[providers]]
# id            = "anthropic"
# name          = "Anthropic Claude"
# type          = "anthropic"
# api_key       = "sk-ant-..."
# default_model = "claude-opus-4-5"
# roles         = ["chat", "code"]
# num_ctx       = 200000
# num_predict   = 4096
# url           = "https://api.anthropic.com" # optional override


# ── OpenAI API (ChatGPT models) ──────────────────────────────────────────────
# Requires an OpenAI API key. A ChatGPT subscription is not an API credential.
# [[providers]]
# id            = "openai"
# name          = "OpenAI"
# type          = "openai"
# api_key       = "sk-..."
# default_model = "gpt-4o"
# roles         = ["chat"]
# num_ctx       = 128000
# num_predict   = 4096
# url           = "https://api.openai.com/v1" # optional override


# ── DeepSeek ──────────────────────────────────────────────────────────────────
# [[providers]]
# id            = "deepseek"
# name          = "DeepSeek"
# type          = "deepseek"
# api_key       = "sk-..."
# default_model = "deepseek-chat"
# roles         = ["chat", "code"]
# num_ctx       = 128000
# num_predict   = 4096
# url           = "https://api.deepseek.com" # optional override


# ── Any OpenAI-compatible server (LM Studio, vLLM, etc.) ─────────────────────
# [[providers]]
# id            = "lm-studio"
# name          = "LM Studio"
# type          = "openai_compatible"
# url           = "http://localhost:1234/v1"
# default_model = "local-model"
# roles         = ["chat"]
# api_key       = "optional-if-required-by-server"
# num_ctx       = 8192
