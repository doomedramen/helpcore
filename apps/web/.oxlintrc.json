{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/exhaustive-deps": "warn"
  },
  "env": {
    "builtin": true
  },
  "settings": {
    "react": {
      "jsxRuntime": "automatic"
    }
  },
  "ignorePatterns": ["out", ".next"]
}
